<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HVAC Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HvacMock.UI.Admin.styles.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark navbar-smart">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-3" asp-controller="Devices" asp-action="Dashboard">
                <div class="nav-icon-wrap">
                    <i class="bi bi-sliders2"></i>
                </div>
                <div>
                    <div class="nav-brand-title">HVAC Admin</div>
                    <div class="nav-brand-sub">Device state and test data</div>
                </div>
            </a>

            @if (Context.Session.GetString("jwt_token") != null)
            {
                <div class="d-flex align-items-center gap-2">
                    <a class="nav-modern-link" asp-controller="Devices" asp-action="Dashboard">
                        <i class="bi bi-speedometer2"></i>
                        Dashboard
                    </a>
                    <a class="nav-modern-link" asp-controller="Devices" asp-action="Index">
                        <i class="bi bi-grid-3x3-gap"></i>
                        Devices
                    </a>
                    <a class="nav-modern-link" asp-controller="Auth" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        Logout
                    </a>
                </div>
            }
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span class="me-2"><i class="bi bi-c-circle"></i> 2026</span>
            Integration Project 2 - HVAC Mock API - Team 8 - Odisee
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/devices.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
