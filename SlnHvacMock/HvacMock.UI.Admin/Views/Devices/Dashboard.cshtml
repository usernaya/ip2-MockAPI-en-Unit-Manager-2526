@model HvacMock.UI.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    // Kleuren per mode voor de grafiek
    var modeColors = new Dictionary<string, string>
    {
        ["heating"] = "#dc3545",
        ["cooling"] = "#0dcaf0",
        ["auto"]    = "#6f42c1",
        ["-"]       = "#6c757d"
    };

    // Kleuren per type
    var typeColors = new Dictionary<string, string>
    {
        ["heating"]        = "#fd7e14",
        ["airConditioner"] = "#0d6efd",
        ["cooling"]        = "#0dcaf0"
    };
}

<div class="container mt-4">

    <h1 class="mb-4">Dashboard</h1>

    @* ── Stat-kaarten ── *@
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm border-0 bg-dark text-white h-100">
                <div class="card-body">
                    <div class="fs-1 fw-bold">@Model.TotalDevices</div>
                    <div class="text-secondary small">Totaal devices</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm border-0 bg-success text-white h-100">
                <div class="card-body">
                    <div class="fs-1 fw-bold">@Model.ActiveDevices</div>
                    <div class="small" style="opacity:.85">Actief (on)</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm border-0 bg-danger text-white h-100">
                <div class="card-body">
                    <div class="fs-1 fw-bold">@Model.InactiveDevices</div>
                    <div class="small" style="opacity:.85">Inactief (off)</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card text-center shadow-sm border-0 bg-warning h-100">
                <div class="card-body">
                    <div class="fs-1 fw-bold">@Model.AverageTemperature °C</div>
                    <div class="small">Gem. temperatuur</div>
                </div>
            </div>
        </div>

    </div>

    @* ── Grafieken ── *@
    @if (Model.TotalDevices > 0)
    {
        <div class="row g-3 mb-4">

            <div class="col-md-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-semibold">Verdeling per mode</div>
                    <div class="card-body d-flex justify-content-center align-items-center">
                        <canvas id="modeChart" style="max-height:220px;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-semibold">Verdeling per type</div>
                    <div class="card-body d-flex justify-content-center align-items-center">
                        <canvas id="typeChart" style="max-height:220px;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-md-2">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-semibold">Modes</div>
                    <div class="card-body p-2">
                        @foreach (var m in Model.ModeDistribution)
                        {
                            var color = modeColors.ContainsKey(m.Key) ? modeColors[m.Key] : "#6c757d";
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge" style="background-color:@color">@m.Key</span>
                                <strong>@m.Value</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    }

    @* ── Devices tabel ── *@
    <div class="card shadow-sm">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
            <span>Alle devices</span>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Naar beheer →</a>
        </div>
        <div class="card-body p-0">
            @if (Model.Devices.Count == 0)
            {
                <div class="p-3 text-muted">Geen devices gevonden.</div>
            }
            else
            {
                <table class="table table-sm table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Model</th>
                            <th>Status</th>
                            <th>Mode</th>
                            <th>Temp.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Devices)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@d.Id">
                                        <code>@d.Id</code>
                                    </a>
                                </td>
                                <td>@d.Type</td>
                                <td>@d.DeviceModel</td>
                                <td>
                                    <span class="badge @(d.Status == "on" ? "bg-success" : "bg-danger")">
                                        @d.Status
                                    </span>
                                </td>
                                <td>@d.Mode</td>
                                <td>@d.Temperature °C</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    // Modedata vanuit Razor
    const modeLabels = [@Html.Raw(string.Join(",", Model.ModeDistribution.Keys.Select(k => $"'{k}'")))];
    const modeData   = [@string.Join(",", Model.ModeDistribution.Values)];
    const modeColors = [@Html.Raw(string.Join(",", Model.ModeDistribution.Keys.Select(k => {
        var c = modeColors.ContainsKey(k) ? modeColors[k] : "#6c757d";
        return $"'{c}'";
    })))];

    // Typedata vanuit Razor
    const typeLabels = [@Html.Raw(string.Join(",", Model.TypeDistribution.Keys.Select(k => $"'{k}'")))];
    const typeData   = [@string.Join(",", Model.TypeDistribution.Values)];
    const typeColors = [@Html.Raw(string.Join(",", Model.TypeDistribution.Keys.Select(k => {
        var c = typeColors.ContainsKey(k) ? typeColors[k] : "#6c757d";
        return $"'{c}'";
    })))];

    new Chart(document.getElementById('modeChart'), {
        type: 'doughnut',
        data: { labels: modeLabels, datasets: [{ data: modeData, backgroundColor: modeColors }] },
        options: { plugins: { legend: { position: 'bottom' } } }
    });

    new Chart(document.getElementById('typeChart'), {
        type: 'doughnut',
        data: { labels: typeLabels, datasets: [{ data: typeData, backgroundColor: typeColors }] },
        options: { plugins: { legend: { position: 'bottom' } } }
    });
</script>
}
