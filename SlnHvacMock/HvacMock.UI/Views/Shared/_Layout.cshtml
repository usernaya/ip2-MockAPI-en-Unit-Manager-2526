<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HVAC Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark navbar-smart">
        <div class="container-fluid px-4">
            <a class="navbar-brand d-flex align-items-center gap-3" asp-controller="Devices" asp-action="Index">
                <div class="nav-icon-wrap">
                    <i class="bi bi-house-gear-fill"></i>
                </div>
                <div>
                    <div class="nav-brand-title">HVAC Control</div>
                    <div class="nav-brand-sub">Smart climate manager</div>
                </div>
            </a>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span class="me-2"><i class="bi bi-c-circle"></i> 2026</span>
            Integration Project 2 - HVAC Mock API - Team 8 - Odisee
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
