@model List<HvacMock.UI.Models.Device>

@{
    ViewData["Title"] = "Devices";
    var onlineCount = Model.Count(device =>
        device.ManagementPoints.FirstOrDefault(mp => mp.ManagementPointCategory == "primary")?.OnOffMode?.Value == "on");
}

<div class="app-page">
    <section class="dashboard-hero">
        <div>
            <span class="eyebrow">HVAC Control</span>
            <h1>Smart climate dashboard</h1>
            <p>Manage indoor units, operating modes, and target temperatures from one clean overview.</p>
        </div>
        <div class="hero-metrics">
            <div>
                <span>@Model.Count</span>
                <small>units</small>
            </div>
            <div>
                <span>@onlineCount</span>
                <small>running</small>
            </div>
        </div>
    </section>

    <section class="device-grid">
        @foreach (var device in Model)
        {
            var primary = device.ManagementPoints.FirstOrDefault(mp => mp.ManagementPointCategory == "primary");
            var isOn = primary?.OnOffMode?.Value == "on";
            var type = device.Type?.ToLowerInvariant() ?? "";
            var iconClass = type.Contains("air") || type.Contains("condition") ? "bi-snow" : "bi-thermometer-sun";
            var iconBg = type.Contains("air") || type.Contains("condition") ? "icon-ac" : "icon-heat";
            var roomName = primary?.Name?.Value ?? "Primary zone";

            <article class="device-card">
                <div class="device-card-top">
                    <div class="device-icon @iconBg">
                        <i class="bi @iconClass"></i>
                    </div>
                    @if (primary?.OnOffMode != null)
                    {
                        <span class="status-pill @(isOn ? "is-on" : "is-off")">
                            <i class="bi bi-power"></i>
                            @primary.OnOffMode.Value
                        </span>
                    }
                </div>

                <div class="device-copy">
                    <span>@device.Id</span>
                    <h2>@device.DeviceModel</h2>
                    <p>@roomName · @device.Type</p>
                </div>

                <div class="device-readout">
                    @if (primary?.TargetTemperature != null)
                    {
                        <strong>@primary.TargetTemperature.Value.ToString("0.#")<sup>°C</sup></strong>
                    }
                    else
                    {
                        <strong class="muted-value">--</strong>
                    }

                    @if (primary?.OperationMode != null)
                    {
                        <span class="mode-pill">
                            <i class="bi bi-wind"></i>
                            @primary.OperationMode.Value
                        </span>
                    }
                </div>

                <a class="manage-link" asp-action="Details" asp-route-id="@device.Id">
                    Manage unit
                    <i class="bi bi-chevron-right"></i>
                </a>
            </article>
        }
    </section>
</div>
