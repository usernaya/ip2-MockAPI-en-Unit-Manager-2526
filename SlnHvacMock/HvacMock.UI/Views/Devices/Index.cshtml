@model List<HvacMock.UI.Models.Device>

@{
    ViewData["Title"] = "Devices";
}

<div class="container mt-4">
    <h1 class="mb-4">Devices</h1>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Mode</th>
                <th>Temperature</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>@d.Id</td>
                    <td>
                        <span class="badge @(d.Status == "on" ? "bg-success" : "bg-danger")">
                            @d.Status
                        </span>
                    </td>
                    <td>@d.Mode</td>
                    <td>@d.Temperature °C</td>
                    <td>
                        <a class="btn btn-primary btn-sm" asp-action="Details" asp-route-id="@d.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>