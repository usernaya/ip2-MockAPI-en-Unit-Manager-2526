@model List<HvacMock.UI.Models.Device>

@{
    ViewData["Title"] = "Devices";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Devices</h1>
        <a asp-action="Create" class="btn btn-success">✚ Nieuw device</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Geen devices gevonden. Maak een nieuw device aan via de knop hierboven.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Model</th>
                    <th>Status</th>
                    <th>Mode</th>
                    <th>Temperatuur</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td><code>@d.Id</code></td>
                        <td>@d.Type</td>
                        <td>@d.DeviceModel</td>
                        <td>
                            <span class="badge @(d.Status == "on" ? "bg-success" : "bg-danger")">
                                @d.Status
                            </span>
                        </td>
                        <td>@d.Mode</td>
                        <td>@d.Temperature °C</td>
                        <td class="text-end">
                            <a class="btn btn-primary btn-sm"
                               asp-action="Details" asp-route-id="@d.Id">Details</a>

                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Device @d.Id verwijderen?')">
                                <input type="hidden" name="id" value="@d.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Verwijder</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>
